# --- Hardware tier --------------------------------------------------------
# small = CPU-only or 4 GB VRAM (default) | medium = 8-12 GB | large = 16+ GB
MODEL_TIER=small
# Force everything onto CPU: Ollama num_gpu=0 and embeddings on CPU.
CPU_ONLY=false

# --- LLM ------------------------------------------------------------------
# ollama (default, local) or openai (API fallback, requires OPENAI_API_KEY)
LLM_PROVIDER=ollama
# Override model name AND quantization (the Ollama tag). Unset = tier default.
# Last resort on tiny machines: qwen2.5:1.5b-instruct-q4_K_M (weak Arabic).
#LLM_MODEL=qwen2.5:3b-instruct-q4_K_M
# Context window in tokens. Unset = tier default (8192 / 16384 / 32768).
# Lower this to save VRAM; KV cache grows with context size.
#LLM_NUM_CTX=8192
# Sampling temperature for both providers. 0 = deterministic (greedy) answers,
# which keeps grounded replies and the test suite reproducible. Raise (e.g. 0.3)
# only if you want more varied phrasing; small models get flakier as it grows.
LLM_TEMPERATURE=0
OLLAMA_BASE_URL=http://localhost:11434
# Layers offloaded to GPU. Unset = Ollama auto. CPU_ONLY=true forces 0.
#OLLAMA_NUM_GPU=
OLLAMA_KEEP_ALIVE=5m

# --- OpenAI-compatible fallback -------------------------------------------
#OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Embeddings -------------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-m3
# auto | cpu | cuda. On 4 GB VRAM keep embeddings on cpu next to the LLM.
EMBEDDING_DEVICE=auto
# Texts per forward pass. Lower to 4-8 on weak CPUs / low RAM.
EMBEDDING_BATCH_SIZE=16
# Where Hugging Face caches model weights (BGE-M3 is ~2.3 GB). Optional.
# Applied by the app before the embedding model loads; also honored by the
# huggingface-cli when set as a real environment variable.
#HF_HOME=./models/hf

# --- Ingestion (Step 2) -------------------------------------------------------
# Required to create companies via POST /api/v1/companies (X-Admin-Key header).
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=
# Uploaded files are stored here, one subfolder per company.
DATA_DIR=./data
# Reject uploads larger than this (megabytes).
MAX_UPLOAD_MB=20
# Chunk target size in characters, and overlap carried between chunks.
CHUNK_SIZE=1200
CHUNK_OVERLAP=200

# --- OCR (optional, for scanned PDFs and images) ------------------------------
# Install extras: pip install -e .[ocr]  +  Tesseract with ara/fra/eng packs.
# Windows: UB-Mannheim installer; set the full path to tesseract.exe.
TESSERACT_CMD=tesseract
# Folder containing ara.traineddata / fra.traineddata / eng.traineddata.
# Needed when packs live outside the default tessdata dir (e.g. no admin rights).
#TESSDATA_PREFIX=
OCR_LANGUAGES=ara+fra+eng

# --- Retrieval and grounded chat (Step 3) -------------------------------------
# Reranker: sharpens hybrid-search ranking with a cross-encoder model. It only
# reorders candidates; the refusal thresholds below still use cosine similarity.
# Unset = tier default: OFF on small (CPU reranking is slow), ON on medium/large.
# First use downloads ~2.3 GB into HF_HOME. Force with true/false.
#RERANK_ENABLED=true
RERANK_MODEL=BAAI/bge-reranker-v2-m3
# How many hybrid-search candidates the reranker re-scores (bounds CPU latency).
RERANK_CANDIDATES=8
# Chunks passed to the LLM as numbered sources.
RETRIEVAL_TOP_K=5
# Two retrieval thresholds split refusals into two kinds. Best-source score
# below RETRIEVAL_OFF_TOPIC_SCORE = off-topic: a polite "I can only help with
# questions about this company", no handoff offer. Between the two thresholds
# (or when the LLM cannot answer from retrieved sources) = company-related but
# not covered: "couldn't find this" plus a "Talk to a human" button that opens
# the handoff form with the question prefilled (the visitor still submits it).
# Both thresholds compare the pre-rerank dense cosine similarity, even when
# reranking is on: the reranker only reorders candidates, and its sigmoid
# probability is a different scale, so it is never used for the thresholds.
# Calibrated on real BGE-M3 scores: off-topic <= 0.3956, related-but-not-
# covered >= 0.4349, in-scope >= 0.45. OFF_TOPIC must be <= MIN_SCORE.
RETRIEVAL_MIN_SCORE=0.43
RETRIEVAL_OFF_TOPIC_SCORE=0.41
# Past messages kept per conversation and replayed to the LLM (0 = no memory).
MEMORY_MAX_TURNS=6

# --- App --------------------------------------------------------------------
APP_NAME=Sanad
LOG_LEVEL=INFO
# Seconds to wait for the LLM before failing with a clear, actionable error.
LLM_TIMEOUT=120

# --- Datastores ---------------------------------------------------------------
# Change the password for any real deployment — defaults are for local dev only.
POSTGRES_USER=sanad
POSTGRES_PASSWORD=sanad
POSTGRES_DB=sanad
DATABASE_URL=postgresql+asyncpg://sanad:sanad@localhost:5432/sanad
# Empty = in-memory cache and counters (fine for a single process). Set for
# shared state across workers/replicas. If Redis is unreachable at startup the
# app logs a warning and falls back to memory instead of refusing to start.
REDIS_URL=
#REDIS_URL=redis://localhost:6379/0

# --- Answer cache and abuse protection (Step 5a) ------------------------------
# Cache grounded first-turn answers. Keys include company id + language +
# question + a document epoch, so answers never leak between companies or
# languages and go stale whenever a document is uploaded, deleted or reindexed.
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600
# Fixed-window chat limits. 0 disables a limit. Exceeded limits return 429
# with a Retry-After header; the widget shows the server message.
RATE_LIMIT_PER_IP=30
RATE_LIMIT_PER_SITE=120
# Hard quota per company per UTC day (resets at midnight UTC).
DAILY_CAP_PER_COMPANY=1000
# Behind a reverse proxy that OVERWRITES X-Forwarded-For, count the first
# entry instead of the proxy IP. Keep false otherwise — clients can spoof it.
TRUST_FORWARDED_FOR=false
# Widget bot deterrent (public site-key path only; secret X-API-Key callers
# are exempt): a hidden honeypot field must stay empty and the panel must have
# been open at least BOT_CHECK_MIN_SECONDS before sending. A deterrent, not a
# security boundary — rate limits and the daily cap are the real backstops.
BOT_CHECK_ENABLED=true
BOT_CHECK_MIN_SECONDS=2.0

# --- Dashboard (Step 5b) ------------------------------------------------------
# Dashboard sessions live in the KV store (Redis, or memory when REDIS_URL is
# empty) and are referenced by an httpOnly, SameSite=Lax cookie. Mutating
# requests must also send the session's CSRF token in X-CSRF-Token.
DASHBOARD_SESSION_HOURS=12
# Login attempts per minute per IP. 0 disables. Exceeded = 429 + Retry-After.
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Set true when the dashboard is served over HTTPS (Secure cookie flag).
COOKIE_SECURE=false
# --- Website crawler (Step 6b) ------------------------------------------------
# Crawl a company website into documents. SSRF protection is always on:
# http/https only, same domain as the start URL, every resolved IP checked
# against private/local ranges, each redirect re-validated, robots.txt
# respected, and the limits below enforced per run.
CRAWL_MAX_PAGES=20
# Pages larger than this are skipped (the start page fails the crawl).
CRAWL_MAX_PAGE_BYTES=2000000
# Per-request timeout and total time budget for one crawl run, in seconds.
CRAWL_TIMEOUT_SECONDS=15
CRAWL_MAX_SECONDS=300
# Re-crawl each source automatically every N hours. 0 disables the schedule
# (manual "Sync now" still works).
CRAWL_RESYNC_HOURS=24
# DANGEROUS — development/tests only: allow private/local IPs (loopback, LAN,
# link-local). Leave false on any real deployment; it disables SSRF protection.
CRAWL_ALLOW_PRIVATE=false
CRAWL_USER_AGENT=SanadBot/0.1 (self-hosted RAG indexer; respects robots.txt)

# --- Human handoff (Step 6c) --------------------------------------------------
# Visitors can ask for a human from the widget. The request is sent to the
# destinations the company sets in dashboard Settings (support email and/or
# Telegram chat id). The transports below are server-level: secrets live ONLY
# in this environment file, never in code or the database, and are never
# returned by the API. An empty SMTP_HOST / TELEGRAM_BOT_TOKEN disables that
# channel for every company (Settings shows whether each is configured).
# SMTP sender for handoff emails. Required when SMTP_HOST is set.
SMTP_HOST=
SMTP_PORT=587
# Leave SMTP_USER empty for an unauthenticated relay (e.g. a local Postfix).
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# STARTTLS on port 587. Set false for a local sink or a TLS-wrapped relay on 465
# (implicit TLS is not supported; use a STARTTLS or plain local relay).
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15
# Create a bot with @BotFather, then message the bot (or add it to a group) and
# read the chat id from getUpdates. The token is a secret: keep it here only.
TELEGRAM_BOT_TOKEN=
# Override only for a proxy or a local test sink.
TELEGRAM_API_BASE=https://api.telegram.org
TELEGRAM_TIMEOUT_SECONDS=15
# Handoff abuse limits. 0 disables. Exceeded = 429 + Retry-After.
HANDOFF_RATE_LIMIT_PER_IP=5
HANDOFF_DAILY_CAP_PER_COMPANY=50
# Privacy: when a company turns OFF "Store conversations", handoff requests are
# still delivered but never written to the database (no Handoffs history).
